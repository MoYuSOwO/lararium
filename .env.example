# 模型 API(OpenAI 兼容接口)
LARARIUM_API_KEY=sk-xxx
LARARIUM_API_BASE_URL=https://opencode.ai/zen/go/v1
# 精确的模型 id 以服务商文档/实际在跑为准,不要照抄注释。
# M5-16 起默认这个:同一端点上三个模型拿**同一份报文**逐格量过(见 REVIEW M5-16),
# 只有它两样都行——多轮记账 32/32 全对、零套壳,而且能读图。
#   DeepSeek-V4-Flash-Vision-Exp  多轮记账 8/8 套壳(会把参数多包一层 arguments),不能用来记账
#   DeepSeek-V4-Flash            记账全对,但端点明确拒绝图片输入
#   Qwen3.8-Flash-Next           记账全对 + 能读图 + 图片注入 2/2 拒绝
LARARIUM_MODEL=Qwen3.8-Flash-Next

LARARIUM_DATA_DIR=./data
LARARIUM_TIMEZONE=Asia/Shanghai
# L0:近期逐字对话流。M3 起按 token 预算截断(默认 200k,用满),L0_MAX_TURNS 只当轮数兜底。
# token 是 len(文本)//2 的中文粗估,只是预算控制不是精确计费。
LARARIUM_L0_MAX_TOKENS=200000
LARARIUM_L0_MAX_TURNS=2000

# 模型调用失败的重试上限(可重试错如 429/5xx 会释放回队列重试,超限才放弃发 notice)
LARARIUM_MAX_ATTEMPTS=3

# M3-4 语义检索(recall_similar)的相似度阈值,0.35 是猜的初值,真机跑几天按实际分布调
LARARIUM_RECALL_MIN_SIMILARITY=0.35
# M3-5 夜间归拢(sweep)的廉价模型,空则用主模型——归拢是扫历史做剪枝,便宜够用就行
LARARIUM_SWEEP_MODEL=

# 服务绑定(默认只绑本机,公网暴露是 M4 Caddy 的事)
# 语义检索的 embedding 权重目录。缺省是 {LARARIUM_DATA_DIR}/embedding,由
# `uv run python scripts/build_embedding_weights.py` 一次性生成(fp16 + mmap,
# 峰值 1772 → 972 MB;2C2G 的机器必须用这个)。没生成的话语义检索降级为不可用,
# 词法检索照常——不会打崩,但 recall_similar 会一直回"暂不可用"。
# LARARIUM_EMBEDDING_DIR=

# 人设文件的位置。缺省是 {LARARIUM_DATA_DIR}/character.md ——**你的**那半截,
# 想让它怎么说话就怎么写;不存在时用内置默认(prompts/character.default.md)。
# 系统纪律在 prompts/discipline.md,那是代码的一部分,不要去改它:
# 里面装着"流水不进账本""说记好了之前先真的调工具"这类几个里程碑打出来的东西,
# 删掉不会有任何报错,只会在某天发现账本里全是午饭。
# LARARIUM_CHARACTER_PATH=

# 主动推送(夜间归拢/压缩的提醒)落在哪个渠道。M5 双通道下对话与推送不是同一个窗口,
# 推送必须落在用户真正在看的那个;单渠道部署保持 cli 即可。只能是 [a-z0-9_-]{1,32}。
LARARIUM_PUSH_CHANNEL=cli

# M5-5 读图。**默认关**,开它是一次明确的选择:
# 一是你接的模型未必能读图(读不了时会白花钱加报错);
# 二是图片是一个**现有防线一条都用不上**的注入面——围栏、折行、中和分隔符、来源标注
#    保护的全是文本,而图里的字根本不经过渲染,没有任何一层能中和它。转发的群截图、
#    别人发来的收据都是不可信来源,而它进的是可信位置。
# 关着的时候图照样收、照样存在 {DATA_DIR}/media/ 下,只是不进模型,并且会告诉你
# "当前模型看不了图"。
# **上面那个默认模型是能读图的**,所以这里改成 on 就直接生效——保持 off 只是不想让
# "复制一份 .env.example"这个动作顺带把一个注入面打开。
LARARIUM_VISION=off

LARARIUM_BIND_HOST=127.0.0.1
LARARIUM_BIND_PORT=8420
# 渠道令牌:token 决定渠道(客户端无权自报)。格式 渠道:token[,渠道:token…]
# 控制端(你):全权,messages + outbox + commands + health 都能碰
LARARIUM_TOKENS=cli:tok-xxx,web:tok-yyy
# 数据面来源(短信/网页等):只准 POST /v1/messages,其余一律 403。
# 命令端点是门控的开关——ingest token 若能按它,恶意短信进站后能自己批准自己
LARARIUM_INGEST_TOKENS=smsforwarder:tok-ingest
