# 模型 API(OpenAI 兼容接口)
LARARIUM_API_KEY=sk-xxx
LARARIUM_API_BASE_URL=https://opencode.ai/zen/go/v1
# 精确的模型 id 以服务商文档/实际在跑为准,不要照抄注释
LARARIUM_MODEL=mimo-v2.5

LARARIUM_DATA_DIR=./data
LARARIUM_TIMEZONE=Asia/Shanghai
# L0:近期逐字对话流。M3 起按 token 预算截断(默认 200k,用满),L0_MAX_TURNS 只当轮数兜底。
# token 是 len(文本)//2 的中文粗估,只是预算控制不是精确计费。
LARARIUM_L0_MAX_TOKENS=200000
LARARIUM_L0_MAX_TURNS=2000

# 模型调用失败的重试上限(可重试错如 429/5xx 会释放回队列重试,超限才放弃发 notice)
LARARIUM_MAX_ATTEMPTS=3

# 服务绑定(默认只绑本机,公网暴露是 M4 Caddy 的事)
LARARIUM_BIND_HOST=127.0.0.1
LARARIUM_BIND_PORT=8420
# 渠道令牌:token 决定渠道(客户端无权自报)。格式 渠道:token[,渠道:token…]
# 控制端(你):全权,messages + outbox + commands + health 都能碰
LARARIUM_TOKENS=cli:tok-xxx,web:tok-yyy
# 数据面来源(短信/网页等):只准 POST /v1/messages,其余一律 403。
# 命令端点是门控的开关——ingest token 若能按它,恶意短信进站后能自己批准自己
LARARIUM_INGEST_TOKENS=smsforwarder:tok-ingest
